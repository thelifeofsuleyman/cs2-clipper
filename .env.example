# Copy this file to .env and fill in the values.

# ───── Telegram (required for upload — see README ) ─────
# Get from @BotFather in Telegram after /newbot.
TG_BOT_TOKEN=123456789:AAEa1bc2DeFG3HIJklMNOPqrstuvwxyz

# Where the bot posts clips. Two ways to get it:
#   1) Channel: add the bot as admin, get the channel ID from @userinfobot or
#      from t.me/c/<chat_id>/... — channel IDs start with -100.
#   2) DM yourself: get your numeric chat_id from @userinfobot.
TG_CHAT_ID=-1001234567890

# ───── OBS WebSocket (defaults match OBS 28+ stock settings) ─────
# In OBS:  Tools -> WebSocket Server Settings -> Enable Server.
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=

# Where OBS writes replay buffer files. Default = Videos folder.
# Find it in OBS: Settings -> Output -> Recording -> Recording Path.
OBS_REPLAY_DIR=C:\Users\Agach\Videos

# ───── Debounce behaviour ─────
# Seconds of "no kill" before the clip is saved. 7 is the sweet spot:
# it bundles a 5-kill ace (~5s between kills) but separates rounds.
DEBOUNCE_SEC=7

# Skip clips with fewer than N kills. 1 = clip every kill, 2 = doubles+.
MIN_KILLS=1

# How long to wait for OBS to finish writing the clip file.
CLIP_WAIT_SEC=8

# Where the GSI listener binds. CS2 GSI cfg POSTs to http://127.0.0.1:3000/.
GSI_PORT=3000
